FROM node:22-alpine  as builder
WORKDIR /app
COPY package*.json ./
RUN npm install -f
COPY . .

# Set any ENVs
ARG REACT_APP_BASE_BACKENED_URL=${REACT_APP_BASE_BACKENED_URL}
ARG REACT_APP_BASE_URL=${REACT_APP_BASE_URL}
ARG REACT_APP_API_BOT=${REACT_APP_API_BOT}
ARG REACT_APP_BASEAPI_URL=${REACT_APP_BASEAPI_URL}
ARG REACT_APP_CLIENT_ID=${REACT_APP_CLIENT_ID}
ARG REACT_APP_PAYSTACK_KEY=${REACT_APP_PAYSTACK_KEY}
ARG REACT_APP_PLAYBACK_URL=${REACT_APP_PLAYBACK_URL}
ARG REACT_APP_FACEBOOK_APP_ID=${REACT_APP_FACEBOOK_APP_ID}
ARG REACT_APP_FACEBOOK_APP_SECRET=${REACT_APP_FACEBOOK_APP_SECRET}
ARG REACT_APP_APPLE_CLIENT_ID=${REACT_APP_APPLE_CLIENT_ID}
ARG REACT_APP_APPLE_REDIRECT_URI=${REACT_APP_APPLE_REDIRECT_URI}
ARG REACT_APP_LANDING_URL=${REACT_APP_LANDING_URL}
ARG REACT_APP_RECORDING_DOWNLOAD_BASE=${REACT_APP_RECORDING_DOWNLOAD_BASE}
ARG REACT_APP_VIDEO_DOWNLOAD_BASE=${REACT_APP_VIDEO_DOWNLOAD_BASE}
ARG REACT_APP_SITE_URL=${REACT_APP_SITE_URL}
ARG REACT_APP_PRIVACY_POLICY_URL=${REACT_APP_PRIVACY_POLICY_URL}
ARG REACT_APP_OG_IMAGE_URL=${REACT_APP_OG_IMAGE_URL}
ARG REACT_APP_FAVICON_URL=${REACT_APP_FAVICON_URL}
ARG REACT_APP_GOOGLE_FONTS_PRECONNECT_URL=${REACT_APP_GOOGLE_FONTS_PRECONNECT_URL}
ARG REACT_APP_GOOGLE_FONTS_STATIC_URL=${REACT_APP_GOOGLE_FONTS_STATIC_URL}
ARG REACT_APP_GOOGLE_FONTS_STYLESHEET_URL=${REACT_APP_GOOGLE_FONTS_STYLESHEET_URL}
ARG REACT_APP_GOOGLE_ANALYTICS_SCRIPT_URL=${REACT_APP_GOOGLE_ANALYTICS_SCRIPT_URL}
ARG REACT_APP_GOOGLE_ANALYTICS_ID=${REACT_APP_GOOGLE_ANALYTICS_ID}
ARG REACT_APP_APPLE_SIGNIN_SDK_URL=${REACT_APP_APPLE_SIGNIN_SDK_URL}
ARG REACT_APP_GOOGLE_USERINFO_URL=${REACT_APP_GOOGLE_USERINFO_URL}
ARG REACT_APP_FACEBOOK_SDK_URL=${REACT_APP_FACEBOOK_SDK_URL}
ARG REACT_APP_JOIN_MEETING_URL=${REACT_APP_JOIN_MEETING_URL}
ARG REACT_APP_GETTING_STARTED_VIDEO_URL=${REACT_APP_GETTING_STARTED_VIDEO_URL}
ARG REACT_APP_CONTACT_SALES_URL=${REACT_APP_CONTACT_SALES_URL}
ARG REACT_APP_GETTING_STARTED_VIDEO_URL=${REACT_APP_GETTING_STARTED_VIDEO_URL}
ARG GENERATE_SOURCEMAP=${GENERATE_SOURCEMAP}

RUN npm run build

# production environment
FROM nginx:1.13.9-alpine
RUN rm -rf /etc/nginx/conf.d
RUN mkdir -p /etc/nginx/conf.d
COPY ./default.conf /etc/nginx/conf.d/
COPY --from=builder /app/build/ /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
